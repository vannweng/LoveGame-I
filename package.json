{
  "name": "lovegame-i",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/domain/*.test.ts",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"tsx --test tests/firestore/*.test.ts\"",
    "test:mission-resolution": "firebase emulators:exec --only firestore \"tsx --test tests/functions/*.test.ts\"",
    "deploy:functions:dev": "firebase deploy --only functions:createMission,functions:resolveMission --project dev"
  },
  "dependencies": {
    "@expo-google-fonts/dotgothic16": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-font": "~14.0.12",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-web-browser": "~15.0.11",
    "firebase": "^12.17.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.26.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.2"
  }
}
